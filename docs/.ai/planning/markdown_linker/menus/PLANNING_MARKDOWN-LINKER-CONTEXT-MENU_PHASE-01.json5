// This JSON5 file serves as a template for the structure of the context menu data. 
// It defines the expected hierarchy, format, and fields for the menu, menu sections, and menu items. 
// This is intended to guide the creation of:
// * The Popup Menu
// * The Context Menu


// // Template / Schema
// // # All `_element` types:
// // * menu: The entire menu structure
// // * menu_item: An abstraction for both menu_section and menu_cell, as they both contain menu_items. This allows for recursive nesting of sections and cells.
// //   * menu_section: A container for grouping related menu items, which can include both other sections and cells. It has a title and an array of menu_items, allowing for nested structures.
// //   * menu_cell: A leaf node in the menu structure, representing an individual actionable item. It has a title, text, and an optional tooltip.
// {
//   {
//     "_element": "menu",                 // UI element: menu
//     "title": "",                        // The title of the menu
//     "tooltip": "",                      // The tooltip text for the menu item (or info icon)
//     "menu_items": [                     // An array of menu items within this section
//       {
//         "_element": "menu_section",     // UI element: menu_section
//         "title": "",                    // The title of the menu section
//         "tooltip": "",                  // The tooltip text for the menu item (or info icon)
//         "menu_items": [                 // An array of menu items within this section    
//          {
//             "_element": "menu_cell",    // UI element: menu_cell
//             "title": "",                // The title of the menu item
//             "text": "",                 // The text content of the menu item
//             "tooltip": ""               // The tooltip text for the menu item (or info icon)
//           }
//         ]
//       }
//     ]
//   }
// }



